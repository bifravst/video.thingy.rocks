{
  "enabled": true,
  "name": "Run Tests on TypeScript Changes",
  "description": "Automatically runs npm test whenever TypeScript files are modified to ensure code changes don't break existing functionality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npm test` in the backend directory to verify all tests pass. If any tests fail, analyze the failures and fix the issues."
  }
}