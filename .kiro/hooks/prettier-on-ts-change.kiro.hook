{
  "enabled": true,
  "name": "Prettier on TypeScript Changes",
  "description": "Automatically runs Prettier to format code whenever TypeScript files are modified to maintain consistent code style",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `npx prettier --write .` to format all code files with Prettier."
  }
}