{
  "name": "video.thingy.rocks-frontend",
  "version": "0.0.0-development",
  "description": "Web frontend for video.thingy.rocks.",
  "type": "module",
  "imports": {
    "#utils/*": {
      "import": "./src/utils/*"
    }
  },
  "homepage": "https://video.thingy.rocks",
  "keywords": [
    "nordicsemiconductor",
    "thingy.rocks",
    "Cat1bis",
    "aws",
    "serverless",
    "video-streaming"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "UNLICENSED",
  "scripts": {
    "start": "vite",
    "build": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build --emptyOutDir",
    "prepare": "husky",
    "test": "node --no-warnings --experimental-transform-types --test \"!(node_modules)/**/*.spec.ts\""
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "classnames": "2.5.1",
    "compare-versions": "6.1.1",
    "date-fns": "4.1.0",
    "lucide-preact": "0.563.0",
    "nanoid": "5.1.6",
    "preact": "10.28.2",
    "preact-router": "4.1.2",
    "semver": "7.7.3"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-assertions": "7.28.6",
    "@bifravst/eslint-config-typescript": "6.4.4",
    "@bifravst/from-env": "3.0.2",
    "@bifravst/prettier-config": "1.1.17",
    "@commitlint/config-conventional": "20.3.1",
    "@preact/preset-vite": "2.10.3",
    "@types/semver": "7.7.1",
    "@typescript/native-preview": "7.0.0-dev.20260127.1",
    "commitlint": "20.3.1",
    "handlebars": "4.7.8",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oidc-client-ts": "3.4.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,html,css}": [
      "prettier --write"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "main"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  }
}
